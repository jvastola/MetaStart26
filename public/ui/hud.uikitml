<!--
  Score panel that floats behind the far edge of the course.
  Element ids are read by src/golf-system.ts.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 360px;
  }

  .content {
    flex-direction: column;
    gap: 6px;
    padding-top: 18px;
    padding-bottom: 10px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .eyebrow {
    color: #2f6b3a;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #8ff0a4;
  }

  .heading {
    color: #1c1d20;
    font-size: 30px;
    font-weight: 700;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .stats {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
  }

  .stat {
    color: #3a3b40;
    font-size: 20px;
    font-weight: 700;
  }

  .stat:dark {
    color: #dddfe3;
  }

  .message {
    color: #3a3b40;
    font-size: 18px;
    line-height: 1.35;
    margin-top: 6px;
  }

  .message:dark {
    color: #c9ccd2;
  }

  .buttons {
    flex-direction: row;
    gap: 10px;
    padding-left: 22px;
    padding-right: 22px;
    padding-bottom: 18px;
  }
</style>
<Panel class="panel-root">
  <div class="content">
    <div id="eyebrow-text" class="eyebrow">DESK LINKS - DAILY COURSE</div>
    <div id="hole-text" class="heading">Hole 1 of 3</div>
    <div class="stats">
      <span id="par-text" class="stat">Par 2</span>
      <span id="strokes-text" class="stat">Strokes 0</span>
      <span id="total-text" class="stat">Total E</span>
    </div>
    <div id="message-text" class="message">Pinch near the ball, pull back, let go.</div>
  </div>
  <div class="buttons">
    <Button id="btn-restart">
      <ButtonIcon>
        <RotateCcw></RotateCcw>
      </ButtonIcon>
      <ButtonLabel id="restart-label">Retry hole</ButtonLabel>
    </Button>
    <Button id="btn-move">
      <ButtonIcon>
        <Move></Move>
      </ButtonIcon>
      <ButtonLabel>Move course</ButtonLabel>
    </Button>
  </div>
</Panel>
